# --- App ---
APP_ENV=development
# Optional. If empty: uses ":$PORT" when PORT is set (Render), else "localhost:8080".
HTTP_ADDR=

# --- Connections ---
# Native dev: localhost | full Docker (.env.docker): db / redis | prod: set in Render dashboard
DATABASE_URL=postgres://ku:ku_dev_password@localhost:5432/ku_acoustic?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# --- goose CLI (loaded automatically from .env) ---
# Prod: GOOSE_DBSTRING must be Neon's DIRECT URL; DATABASE_URL uses the pooled one.
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://ku:ku_dev_password@localhost:5432/ku_acoustic?sslmode=disable
GOOSE_MIGRATION_DIR=db/migrations